# The running Jira Data Bridge proxy. Start it with:
#   cd ../jira-data-bridge && npm install && npm run dev
BRIDGE_URL=http://localhost:5173/jira-proxy

# Your Atlassian site origin (Jira and Confluence share it on Cloud).
ATLASSIAN_SITE=https://your-site.atlassian.net

# cloud  = account email + API token (Basic auth)
# server = personal access token (Bearer auth)
ATLASSIAN_DEPLOYMENT=cloud

# Required for Cloud (Basic auth); leave blank for Server/DC.
ATLASSIAN_EMAIL=you@example.com

# Cloud API token (id.atlassian.com -> Security -> API tokens) or a Server/DC PAT.
ATLASSIAN_TOKEN=your-token-here
